# =============================================================================
# contract-driven-platform — environment variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# AWS is OPTIONAL — the platform runs fully locally without it.
# =============================================================================

# ── Confluent Cloud (required) ────────────────────────────────────────────────
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_API_KEY=your_confluent_api_key
CONFLUENT_API_SECRET=your_confluent_api_secret
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxxx.us-east-1.aws.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=your_sr_api_key
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=your_sr_api_secret

# ── Kafka topics ──────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret
TOPIC_ORDERS=orders
TOPIC_CLICKSTREAM=clickstream
TOPIC_PAYMENTS=payments
TOPIC_WEATHER=weather
TOPIC_DLQ=dead-letter-queue

# ── Producer throughput ───────────────────────────────────────────────────────
MALFORMED_RATE=0.05
ORDERS_EVENTS_PER_SECOND=2
CLICKSTREAM_EVENTS_PER_SECOND=5
PAYMENTS_EVENTS_PER_SECOND=1.5
WEATHER_POLL_INTERVAL_SECONDS=60

# ── OpenWeatherMap (optional — falls back to synthetic data) ──────────────────
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# ── Delta Lake storage ────────────────────────────────────────────────────────
# Default: writes to local filesystem — no AWS needed
LOCAL_DELTA_PATH=/tmp/contract-driven-platform

# To use AWS S3 instead, set USE_S3=true and fill in the three values below:
USE_S3=false
# S3_BUCKET=your-s3-bucket-name
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1

# ── Kafka ingest consumer tuning ─────────────────────────────────────────────────────
INGEST_CONSUMER_GROUP=ingest-bronze-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
BATCH_MAX_RECORDS=500
BATCH_TIMEOUT_SEC=10.0
POLL_TIMEOUT_SEC=1.0
MAX_RETRIES=3
RETRY_BACKOFF_SEC=2.0

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_APP_NAME=contract-driven-bronze-writer
SPARK_MASTER=local[*]
LOG_LEVEL=INFO

# ── Superset ──────────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=contract-driven-platform-superset-key

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_HOME=~/airflow
